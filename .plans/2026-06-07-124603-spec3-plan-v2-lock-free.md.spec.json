{
  "version": 1,
  "verifiers": {
    "dependencies": ["scripts/verify-dependencies.sh"],
    "exports": ["scripts/verify-exports.sh"],
    "enumerations": ["scripts/verify-enumerations.sh"]
  },
  "requirements": {
    "tree": [
      {
        "id": "WORKSPACE_TREE",
        "reason": [
          "Goal + Public Library Surface: a Rust CLI (src/main.rs) and library (src/lib.rs).",
          "Implementation Order step 1: root Cargo.toml.",
          "G3RS And Test Policy: guardrail3-rs.toml; do not add a tests/ directory.",
          "Front-loaded help: HELP.txt is the committed help body."
        ],
        "requiredPaths": [
          "Cargo.toml",
          "guardrail3-rs.toml",
          "src/lib.rs",
          "src/main.rs",
          "HELP.txt"
        ],
        "forbiddenGlobs": ["tests/**", "**/tests/**"]
      }
    ],
    "content": [
      {
        "id": "RUST_FORBIDDEN_SUBSTRINGS",
        "reason": [
          "G3RS And Test Policy: do not add #[test] or #[cfg(test)].",
          "Design principles + V1 Definition Of Done: no bypass flags (--force, --skip). Substring tripwire; a false positive surfaces for adjudication."
        ],
        "files": ["**/*.rs"],
        "forbiddenSubstrings": ["#[test]", "#[cfg(test)]", "--force", "--skip"],
        "requiredSubstrings": []
      }
    ],
    "dependencies": [
      {
        "id": "WORKSPACE_CRATES",
        "reason": [
          "V1 Source Format validation stack: serde, serde_json, schemars, jsonschema, garde.",
          "Path, Glob, And Walk Semantics: camino, globset.",
          "Backend attachment: aqc-filetree, aqc-fs-utils, aqc-git-helpers.",
          "V1 Source Format / Dependency Health Gate: validator, jsonc-parser, serde_json_canonicalizer, canon-json forbidden.",
          "Boundary With Guardrail3 v2: no g3*/guardrail* crates, no aqc-shared engine crates."
        ],
        "manifestGlobs": ["Cargo.toml"],
        "requiredCrates": [
          "serde",
          "serde_json",
          "schemars",
          "jsonschema",
          "garde",
          "camino",
          "globset",
          "aqc-filetree",
          "aqc-fs-utils",
          "aqc-git-helpers"
        ],
        "forbiddenCrates": [
          "validator",
          "jsonc-parser",
          "serde_json_canonicalizer",
          "canon-json",
          "aqc-file-engine-core",
          "aqc-cargo-toml-engine",
          "aqc-clippy-toml-engine"
        ],
        "forbiddenCratePrefixes": ["g3", "guardrail"]
      }
    ],
    "exports": [
      {
        "id": "PUBLIC_LIBRARY_SURFACE",
        "reason": "Public Library Surface: exposed from src/lib.rs.",
        "package": "spec3",
        "types": [
          "Spec",
          "Requirements",
          "TreeRequirement",
          "ContentRequirement",
          "DependencyRequirement",
          "ExportRequirement",
          "EnumerationRequirement",
          "SchemaRequirement",
          "Category",
          "Report",
          "Evidence",
          "Status",
          "VerifierSource",
          "LintError",
          "SpecViolation",
          "VerifyError"
        ],
        "functions": ["lint", "verify"]
      }
    ],
    "enumerations": [
      {
        "id": "ENUM_CATEGORY",
        "reason": "Public Library Surface: Category is the closed set of six.",
        "type": "Category",
        "variants": ["Tree", "Content", "Dependencies", "Exports", "Enumerations", "Schemas"]
      },
      {
        "id": "ENUM_STATUS",
        "reason": "Public Library Surface: Status { Pass, Fail }; no soft states.",
        "type": "Status",
        "variants": ["Pass", "Fail"]
      },
      {
        "id": "ENUM_VERIFIER_SOURCE",
        "reason": "Public Library Surface: VerifierSource { Builtin, Custom }.",
        "type": "VerifierSource",
        "variants": ["Builtin", "Custom"]
      }
    ]
  }
}
