{
  "version": 1,
  "verifiers": {
    "dependencies": ["scripts/verify-dependencies.sh"],
    "exports": ["scripts/verify-exports.sh"],
    "enumerations": ["scripts/verify-enumerations.sh"],
    "custom": ["scripts/verify-custom.sh"]
  },
  "requirements": {
    "tree": {
      "reason": [
        "Plan: Code changes require src/model.rs, src/lint.rs, src/verify.rs, src/evidence.rs, src/main.rs.",
        "Plan: HELP.txt is rewritten and embedded.",
        "Plan: build-contract scripts are rewritten.",
        "Plan: no tests directory."
      ],
      "required": [
        "Cargo.toml",
        "HELP.txt",
        "src/model.rs",
        "src/lint.rs",
        "src/verify.rs",
        "src/evidence.rs",
        "src/main.rs",
        "src/lib.rs",
        "scripts/verify-dependencies.sh",
        "scripts/verify-exports.sh",
        "scripts/verify-enumerations.sh",
        "scripts/verify-custom.sh"
      ],
      "forbidden": ["tests/**", "**/tests/**"]
    },
    "content": [
      {
        "files": ["HELP.txt"],
        "reason": "Plan: HELP documents the new format, quantifiers, one wire protocol, JSON-only output, lint rules, workflow, and report shape.",
        "required": [
          "\"tree\": {",
          "\"custom\":",
          "required   each item is present in every matched place",
          "Typed categories run once per block",
          "Custom runs once",
          "Output is always JSON.",
          "DUPLICATE_TARGET",
          "CUSTOM_SHAPE",
          "\"conforms\": false"
        ],
        "forbidden": ["schemas", "forbiddenPrefixes"]
      },
      {
        "files": ["src/model.rs"],
        "reason": "Plan: model has no IDs, tree is an object, schemas are deleted, custom is opaque.",
        "required": [
          "pub tree: TreeRequirement",
          "pub custom: Vec<serde_json::Value>",
          "pub enum Category",
          "Custom"
        ],
        "forbidden": ["pub id:", "SchemaRequirement", "Schemas"]
      },
      {
        "files": ["src/lint.rs"],
        "reason": "Plan: lint implements the new rule set and deletes ID checks.",
        "required": [
          "DUPLICATE_TARGET",
          "DUPLICATE_ITEM",
          "CONTRADICTION",
          "REDUNDANT",
          "ITEM_FORMAT",
          "EXISTS_SINGLE_PLACE",
          "DEAD_VERIFIER",
          "CUSTOM_SHAPE"
        ],
        "forbidden": ["DUPLICATE_ID", "ID_FORMAT", "MERGEABLE_REQUIREMENTS"]
      },
      {
        "files": ["src/verify.rs"],
        "reason": "Plan: verify emits per-item evidence, runs typed scripts per block, runs custom once, and times out scripts after 60 seconds.",
        "required": [
          "const VERIFIER_TIMEOUT: Duration = Duration::from_secs(60)",
          "block_index",
          "custom verifier emitted zero evidence lines",
          "reported item",
          "produced no evidence"
        ],
        "forbidden": ["category_ids", "check_coverage"]
      },
      {
        "files": ["src/main.rs"],
        "reason": "Plan: CLI is JSON-only and --json is deleted.",
        "required": [
          "flags are not supported; output is always JSON",
          "serde_json::to_string_pretty(report)"
        ],
        "forbidden": ["--json", "LINT PASS", "spec sha256:"]
      }
    ],
    "dependencies": [
      {
        "manifests": ["Cargo.toml"],
        "reason": "Plan: no new dependency is required; existing serde/jsonschema/globset stack remains.",
        "required": [
          "serde",
          "serde_json",
          "schemars",
          "jsonschema",
          "camino",
          "globset",
          "aqc-filetree",
          "aqc-fs-utils",
          "aqc-git-helpers"
        ],
        "forbidden": [
          "validator",
          "jsonc-parser",
          "serde_json_canonicalizer",
          "canon-json",
          "guardrail*",
          "g3*"
        ]
      }
    ],
    "exports": [
      {
        "package": "speculus",
        "reason": "Plan: public library surface reflects the new model and report types.",
        "required": [
          "Spec",
          "Requirements",
          "TreeRequirement",
          "ContentRequirement",
          "DependencyRequirement",
          "ExportRequirement",
          "EnumerationRequirement",
          "Category",
          "Report",
          "Evidence",
          "Status",
          "VerifierSource",
          "Polarity",
          "WireEvidence",
          "LintError",
          "SpecViolation",
          "VerifyError",
          "lint",
          "verify"
        ],
        "forbidden": ["SchemaRequirement"]
      }
    ],
    "enumerations": [
      {
        "name": "Category",
        "reason": "Plan: categories are the closed typed set with custom replacing schemas.",
        "values": ["Tree", "Content", "Dependencies", "Exports", "Enumerations", "Custom"]
      },
      {
        "name": "Status",
        "reason": "Plan: status has only pass and fail.",
        "values": ["Pass", "Fail"]
      },
      {
        "name": "VerifierSource",
        "reason": "Plan: source is builtin or custom.",
        "values": ["Builtin", "Custom"]
      },
      {
        "name": "Polarity",
        "reason": "Plan: typed evidence uses required, exists, and forbidden quantifiers.",
        "values": ["Required", "Exists", "Forbidden"]
      }
    ],
    "custom": [
      {
        "check": "help-json-only",
        "file": "HELP.txt",
        "mode": "contains",
        "text": "No flags exist. Output is always JSON."
      },
      {
        "check": "main-no-json-flag",
        "file": "src/main.rs",
        "mode": "absent",
        "text": "--json"
      },
      {
        "check": "timeout-documented",
        "file": "HELP.txt",
        "mode": "contains",
        "text": "60 second timeout"
      }
    ]
  }
}
