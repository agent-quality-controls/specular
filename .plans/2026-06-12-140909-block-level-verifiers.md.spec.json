      "verifier": [
        "builtin:tree"
      ]
    },
    "content": [
      {
        "files": [
          "src/model.rs"
        ],
        "reason": "Plan: model owns version 2 and block-level verifier fields.",
        "required": [
          "pub struct VerifierCommand",
          "pub verifier: VerifierCommand",
          "CustomRequirement",
          "flatten"
        ],
        "forbidden": [
          "pub verifiers: BTreeMap<String, Vec<String>>",
          "has_builtin(self)"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "src/lint.rs"
        ],
        "reason": "Plan: lint validates block-level verifier commands and builtin compatibility.",
        "required": [
          "VERIFIER_MISSING",
          "UNKNOWN_BUILTIN_VERIFIER",
          "BUILTIN_CATEGORY_MISMATCH",
          "VERIFIER_COMMAND_EMPTY",
          "version must be 2",
          "builtin:tree",
          "builtin:content"
        ],
        "forbidden": [
          "CATEGORY_HAS_NO_VERIFIER",
          "DEAD_VERIFIER",
          "UNKNOWN_CATEGORY"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "src/verify.rs"
        ],
        "reason": "Plan: verify dispatches each block by its own verifier argv.",
        "required": [
          "builtin:tree",
          "builtin:content",
          "run_builtin",
          "run_script",
          "block.verifier",
          "custom",
          "block_index"
        ],
        "forbidden": [
          "spec.verifiers.get(category.as_str())"
