        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "src/evidence.rs"
        ],
        "reason": "Plan: evidence records the exact verifier and script source.",
        "required": [
          "pub verifier: String",
          "Script"
        ],
        "forbidden": [
          "Custom,"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "HELP.txt"
        ],
        "reason": "Plan: help documents the new version 2 format and builtins.",
        "required": [
          "\"version\": 2",
          "\"verifier\"",
          "builtin:tree",
          "builtin:content",
          "scripts/verify_deps.py",
          "top-level verifiers"
        ],
        "forbidden": [
          "\"verifiers\": {",
          "builtin when no verifier is declared"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "README.md"
        ],
        "reason": "Plan: README explains explicit block-level verifier selection.",
        "required": [
          "\"verifier\"",
          "block-level verifier",
          "builtin:tree",
          "builtin:content"
        ],
        "forbidden": [
          "\"verifiers\": {"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "scripts/verify-repo-quality.py"
        ],
        "reason": "Plan: existing custom verifier accepts custom per-entry protocol.",
        "required": [
          "block_index",
          "requirements",
          "custom"
        ],
        "verifier": [
          "builtin:content"
        ]
      },
      {
        "files": [
          "scripts/verify-block-level-verifiers.py"
        ],
        "reason": "Plan: the migration dogfoods Specular with a purpose-built verifier.",
        "required": [
          "check_valid_fixture_specs_v2",
          "check_new_lint_fixtures",
          "check_golden_reports",
          "check_protocol_docs",
          "block-level-verifiers"
        ],
        "verifier": [
          "builtin:content"
        ]
      }
    ],
    "custom": [
      {
        "check": "valid-fixture-specs-v2",
        "reason": "Plan: valid behavior fixture specs migrate to version 2 and block-level verifiers.",
        "verifier": [
          "scripts/verify-block-level-verifiers.py"
        ]
      },
      {
        "check": "new-lint-fixtures",
        "reason": "Plan: migration adds lint fixtures for missing verifier, unknown builtin, category mismatch, and rejected top-level verifiers.",
        "verifier": [
          "scripts/verify-block-level-verifiers.py"
        ]
      },
      {
        "check": "golden-reports",
        "reason": "Plan: golden reports include evidence verifier identity and use script source for external verifiers.",
        "verifier": [
          "scripts/verify-block-level-verifiers.py"
        ]
      },
      {
        "check": "protocol-docs",
        "reason": "Plan: help and README document one block-level verifier command, not a list of verifiers.",
        "verifier": [
          "scripts/verify-block-level-verifiers.py"
        ]
      },
      {
        "check": "repo-plan-specs-v2",
        "reason": "Plan: local Specular plan specs used by this repo migrate to the version 2 format.",
        "verifier": [
          "scripts/verify-block-level-verifiers.py"
        ]
      }
    ]
  }
