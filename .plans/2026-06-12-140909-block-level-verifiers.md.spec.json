        ".plans/2026-06-12-140909-block-level-verifiers.md.spec.coverage.md",
        "src/model.rs",
        "src/lint.rs",
        "src/verify.rs",
        "src/evidence.rs",
        "HELP.txt",
        "README.md",
        "scripts/verify-repo-quality.py",
        "scripts/verify-block-level-verifiers.py",
        "behavior/fixtures",
        "behavior/golden"
