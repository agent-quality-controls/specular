{
  "version": 4,
  "requirements": {
    "tree": {
      "required": [
        "README.md"
      ],
      "forbidden": [
        "tmp/**"
      ],
      "verifier": [
        "builtin:tree"
      ]
    },
    "content": [
      {
        "files": [
          "docs/*.txt"
        ],
        "required": [
          "INVOICE"
        ],
        "forbidden": [
          "LEGACY"
        ],
        "verifier": [
          "builtin:content"
        ]
      }
    ],
    "dependencies": [
      {
        "files": [
          "Cargo.toml"
        ],
        "forbidden": [
          "pg"
        ],
        "verifier": [
          "scripts/v.sh"
        ]
      }
    ]
  }
}
