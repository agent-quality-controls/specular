{
  "version": 1,
  "verifiers": {
    "dependencies": ["scripts/deps.sh"],
    "custom": ["scripts/custom.sh"]
  },
  "requirements": {
    "tree": {
      "required": ["docs/readme.txt"],
      "forbidden": ["junk/**"]
    },
    "content": [
      {
        "files": ["docs/*.txt"],
        "required": ["INVOICE"],
        "exists": ["ledger"],
        "forbidden": ["LEGACY"]
      }
    ],
    "dependencies": [
      {
        "manifests": ["go.mod"],
        "forbidden": ["pg"]
      }
    ],
    "custom": [
      {
        "check": "version-sync"
      }
    ]
  }
}
